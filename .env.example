APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# REST API (routes/api/v1.php) — see API_Development_Plan.md
#
# Every value below has a production-safe default in config/api.php. Set them
# here only to override. They exist as env vars so a live incident can be
# handled with an .env change instead of a code deploy.
###############################################################################

# Pagination. `API_MAX_PER_PAGE` is a hard ceiling: a client asking for more
# gets a 422, not a silently truncated page.
# API_DEFAULT_PER_PAGE=25
# API_MAX_PER_PAGE=100

# Rate limits, requests per minute. `AUTH` is keyed on email+IP; the rest are
# keyed on the authenticated user id.
# API_RATE_LIMIT_AUTH=5
# API_RATE_LIMIT_READ=120
# API_RATE_LIMIT_WRITE=40
# API_RATE_LIMIT_REPORTS=10

# Access tokens. TTL default is 30 days. `MAX_TOKENS_PER_USER` evicts the
# least-recently-used session rather than refusing a new login.
# API_TOKEN_TTL_MINUTES=43200
# API_MAX_TOKENS_PER_USER=10

# Require an Idempotency-Key header on every POST/PUT/PATCH/DELETE. Keep this
# ON: it is what stops a retried request on a weak link from posting the same
# voucher twice. Turn it off only for a client that genuinely cannot comply.
# API_REQUIRE_IDEMPOTENCY_KEY=true

# Public API reference at /api/docs, generated by Scribe and committed under
# public/api/docs/. The OG values drive the link-preview card when the URL is
# pasted into WhatsApp / X / Slack.
# The PUBLIC origin the docs describe. NOT derived from APP_URL: the docs are
# generated on a developer machine and committed, so APP_URL would ship
# "localhost" as the documented API host. Override only for staging.
# API_DOCS_PUBLIC_URL=https://app.electrotech.findosystem.com
# API_DOCS_ENABLED=true
# API_DOCS_OG_TITLE="Electrotech API — توثيق واجهات النظام"
# API_DOCS_OG_DESCRIPTION="..."
# API_DOCS_OG_IMAGE=/electrotech-logo.jpg
# API_DOCS_TWITTER_SITE=@yourhandle
