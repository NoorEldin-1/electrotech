                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "Returns every permission in the catalog, grouped by its prefix, with the\nlocalized label the panel shows. Bounded (~190 rows, fixed by the\nseeder) so it is not paginated.\n\nLabels honour `Accept-Language`."
